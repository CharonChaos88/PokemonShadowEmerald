	setspeaker(SP_NAME_WISDOM)

// Regular static use
dynmultichoice(
  17,
  0,
  FALSE,
  10,
  0,
  DYN_MULTICHOICE_CB_NONE,
  "Move Tutor",
  "Item Shop",
  "Wonder Trade",
