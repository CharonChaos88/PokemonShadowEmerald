script ItemShopMenu {
	if(var(VAR_MEGA_ALAKAZAM_ITEM_SHOP) == 1) {
		setspeaker(SP_NAME_WISDOM)
		msgbox(FirstTimeItemShop, MSGBOX_DEFAULT)
		setvar(VAR_MEGA_ALAKAZAM_ITEM_SHOP, 2)
		goto(ItemShopMenuList)
	} else {
		goto(ItemShopMenuList)
	}
}

script ItemShopMenuList {
	dynmultichoice(
  17,
  0,
  FALSE,
  4,
  0,
  DYN_MULTICHOICE_CB_NONE,
  "No Badges",
  "Stone Badge",
  "Knuckle Badge",
  "Dynamo Badge",
  "Heat Badge",
  "Balance Badge",
  "Feather Badge",
  "Mind Badge",
  "Rain Badge",
  "Evolution Stones",
  "Go Back"
)

switch (var(VAR_RESULT)) {
  case 0:
    goto(NoBadgeItemShop)
  case 1:
    goto(StoneBadgeItemShopMenu)
  case 2:
    goto(KnuckleBadgeItemShopMenu)
  case 3:
    goto(DynamoBadgeItemShopMenu)
  case 4:
    goto(HeatBadgeItemShopMenu)
  case 5:
    goto(BalanceBadgeItemShopMenu)
  case 6:
    goto(FeatherBadgeItemShopMenu)
  case 7:
    goto(MindBadgeItemShopMenu)
  case 8:
    goto(RainBadgeItemShopMenu)
  case 9:
    goto(EvolutionStoneShopMenu)
  case 10:
    goto(PokemonCompendium2)
	}
  goto_if_eq(VAR_RESULT, 127, PokemonCompendium2)
}

// ITEM SHOP LIST

script NoBadgeItemShop {
    lock
    message("Welcome to the no badge shop.")
    pokemart(NoBadgeShop)
    goto(ItemShopMenuList)
}

mart NoBadgeShop {
    ITEM_POKE_BALL
    ITEM_POTION
    ITEM_AWAKENING
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_BURN_HEAL
    ITEM_ICE_HEAL
    ITEM_REPEL
}

script StoneBadgeItemShopMenu {
	lock
	if(flag(FLAG_BADGE01_GET) == FALSE)
