script DynamoBadgeMoveTutor {
    lock 
    faceplayer
    if(flag(FLAG_BADGE03_GET) == FALSE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Unfortunately, it seems you don't have the Dynamo Badge."))
        goto(MoveTutorMenu)
    } else {
        // --- DYNAMIC MULTICHOICE MENU FOR MOVES ---
        // Physical Mid-Game Progression Attacks
        dynmultipush("Flame Wheel", MOVE_FLAME_WHEEL)
        dynmultipush("Water Pulse", MOVE_WATER_PULSE)
        dynmultipush("Bite", MOVE_BITE)
        dynmultipush("Spark", MOVE_SPARK)
        dynmultipush("Force Palm", MOVE_FORCE_PALM)
        dynmultipush("Aerial Ace", MOVE_AERIAL_ACE)
        dynmultipush("Shadow Claw", MOVE_SHADOW_CLAW)
        dynmultipush("Bulldoze", MOVE_BULLDOZE)
