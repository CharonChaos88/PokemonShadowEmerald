        dynmultipush("Bug Bite", MOVE_BUG_BITE)
        dynmultipush("Pluck", MOVE_PLUCK)
        dynmultipush("Smart Strike", MOVE_SMART_STRIKE)
        dynmultipush("Metal Claw", MOVE_METAL_CLAW)
        dynmultipush("Stomp", MOVE_STOMP)
        dynmultipush("Covet", MOVE_COVET)
        dynmultipush("Shock Wave", MOVE_SHOCK_WAVE)
        dynmultipush("Swift", MOVE_SWIFT)
