text Text_ShowPackContents {
    "The Mystery Gift contains:\n"
    "{STR_VAR_1}"
}

text Text_ShowPackContentsDemo2 {
    "The Demo 2 Pack contains:\n"
    "{STR_VAR_1}"
}

text Text_ReceivedDemo2Pack {
    "{PLAYER} received the Demo 2 Pack!"
}

text Text_BagIsFull {
    "Oh no! You don't have enough room\n"
    "in your Bag for all of these items."
}


script MysteryManGreeting {
    setspeaker("Mystery Man")
    msgbox(format("Hello, would you like to use the Mystery Gift?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
    msgbox(format("Enter a code."))
    special(EnterCode)
    waitstate
    special(GetCodeFeedback)
    compare(VAR_RESULT, 0)
    goto_if_eq(VAR_RESULT, 0, IncorrectCode)
    goto_if_eq(VAR_RESULT, 1, Demo2Code)
	  goto_if_eq(VAR_RESULT, 2, ShinyStarterWithZigzagoon)      
    end
    } else {
        setspeaker("Mystery Man")
        msgbox(format("Please come back when you discover a code."))
        release
        end
    }

}

script IncorrectCode {
        setspeaker("Mystery Man")
        msgbox(format("Sorry, that code is incorrect."))
        goto(ComebackWithCode)
}

script ComebackWithCode {
        setspeaker("Mystery Man")
        msgbox(format("Please come back when you discover a code."))
        release
        end
}

script Demo2Code {
    if(flag(FLAG_MYSTERY_GIFT_16) == TRUE) {
        setspeaker("Mystery Man")
        msgbox(format("I am sorry but you have already redeemed this code."))
        playfanfare(MUS_TOO_BAD)
        waitfanfare
        goto(ComebackWithCode)
    } else {
        setspeaker("Mystery Man")
        msgbox(format("Thank you for entering in the Demo 2 code. Here's your item pack."))
        playfanfare(MUS_EVOLVED)
        waitfanfare
        
        // Jump over to raw assembly to handle the items
        goto(MysteryGift_Code_RawPart)
    }
}

script Demo2Code_PostDisplay {
    // Check if the transaction was successful
    if (var(VAR_RESULT) == FALSE) {
        setspeaker("Mystery Man")
        msgbox(format("Oh no! You don't have enough room in your Bag for all of these items."))
    } else {
        playfanfare(MUS_OBTAIN_ITEM)
        setspeaker("Mystery Man")
        msgbox(format("{PLAYER} received the item pack!"))
        waitfanfare
        setflag(FLAG_MYSTERY_GIFT_16)
    }
    goto(ComebackWithCode)
}

raw `
MysteryGift_Code_RawPart::
    @ List your items here. The macro will automatically append 0xFFFF at the end.
    giveitempack ITEM_GREAT_BALL, 10, ITEM_HYPER_POTION, 10, ITEM_FIRE_STONE, 10, ITEM_WATER_STONE, 10, ITEM_THUNDER_STONE, 10, ITEM_LEAF_STONE, 10, ITEM_SUN_STONE, 10, ITEM_MOON_STONE, 10, ITEM_ICE_STONE, 10, ITEM_DUSK_STONE, 10, ITEM_SHINY_STONE, 10, ITEM_DAWN_STONE, 10, ITEM_JOLLY_MINT, 10, ITEM_ADAMANT_MINT, 10, ITEM_BOLD_MINT, 10, ITEM_NAIVE_MINT, 10, ITEM_MODEST_MINT, 10, ITEM_HASTY_MINT, 10, ITEM_RELAXED_MINT, 10, ITEM_LAX_MINT, 10, ITEM_TIMID_MINT, 10, ITEM_GENTLE_MINT, 10, ITEM_NAUGHTY_MINT, 10, ITEM_BRAVE_MINT, 10, ITEM_MILD_MINT, 10, ITEM_CALM_MINT, 10, ITEM_IMPISH_MINT, 10, ITEM_LONELY_MINT, 10, ITEM_RASH_MINT, 10, ITEM_SASSY_MINT, 10, ITEM_SERIOUS_MINT, 10, ITEM_CAREFUL_MINT, 10, ITEM_LINKING_CORD, 10, ITEM_BOTTLE_CAP, 10
    
    @ Explicitly handle the message drawing without closing the speaker tags
    loadword 0, gLargeItemPackBuffer
    message 0x0
    waitmessage
    waitbuttonpress
    closemessage
    
    goto Demo2Code_PostDisplay
`

script ShinyStarterWithZigzagoon {
    if(flag(FLAG_MYSTERY_GIFT_17) == TRUE) {
        setspeaker("Mystery Man")
        msgbox(format("I am sorry but you have already redeemed this code."))
        playfanfare(MUS_TOO_BAD)
        waitfanfare
        goto(ComebackWithCode)
    } else {
    setspeaker("Mystery Man")
    msgbox(format("Thank you for entering in the Shiny Starter code."))
    playfanfare(MUS_EVOLVED)
    waitfanfare
    msgbox(format("Here is your Shiny Zigzagoon."))
	createmon(0, 6, SPECIES_ZIGZAGOON, 5, ITEM_NONE, BALL_CHERISH, NATURE_RANDOM, NUM_ABILITY_PERSONALITY, MON_GENDER_RANDOM, 0, 0, 0, 0, 0, 0, MAX_PER_STAT_IVS, MAX_PER_STAT_IVS, MAX_PER_STAT_IVS, MAX_PER_STAT_IVS, MAX_PER_STAT_IVS, MAX_PER_STAT_IVS, MOVE_DEFAULT, MOVE_DEFAULT, MOVE_DEFAULT, MOVE_DEFAULT, SHINY_MODE_ALWAYS, 0, 0, 10)
    goto(ShinyStarterMenu)
}
}


script ShinyStarterMenu {
    lock
    faceplayer
	setflag(FLAG_SUPPRESS_SPEAKER_NAME)
	msgbox("Choose your shiny starter.")
	hidemonpic
	waitmessage
    goto(ShinyStarters)
	}

  script ShinyStarters {
	    dynmultipush("Bulbasaur", SPECIES_BULBASAUR)
	    dynmultipush("Charmander", SPECIES_CHARMANDER)
	    dynmultipush("Squirtle", SPECIES_SQUIRTLE)
    	dynmultipush("Chikorita", SPECIES_CHIKORITA)
    	dynmultipush("Cyndaquil", SPECIES_CYNDAQUIL)
    	dynmultipush("Totodile", SPECIES_TOTODILE)
	    dynmultipush("Treecko", SPECIES_TREECKO)
    	dynmultipush("Torchic", SPECIES_TORCHIC)
    	dynmultipush("Mudkip", SPECIES_MUDKIP)
   	 	dynmultipush("Turtwig", SPECIES_TURTWIG)
    	dynmultipush("Chimchar", SPECIES_CHIMCHAR)
    	dynmultipush("Piplup", SPECIES_PIPLUP)
    	dynmultipush("Snivy", SPECIES_SNIVY)
    	dynmultipush("Tepig", SPECIES_TEPIG)
    	dynmultipush("Oshawott", SPECIES_OSHAWOTT)
    	dynmultipush("Chespin", SPECIES_CHESPIN)
    	dynmultipush("Fennekin", SPECIES_FENNEKIN)
    	dynmultipush("Froakie", SPECIES_FROAKIE)
    	dynmultipush("Rowlet", SPECIES_ROWLET)
    	dynmultipush("Litten", SPECIES_LITTEN)
    	dynmultipush("Popplio", SPECIES_POPPLIO)
    	dynmultipush("Grookey", SPECIES_GROOKEY)
    	dynmultipush("Scorbunny", SPECIES_SCORBUNNY)
    	dynmultipush("Sobble", SPECIES_SOBBLE)
    	dynmultipush("Sprigatito", SPECIES_SPRIGATITO)
    	dynmultipush("Fuecoco", SPECIES_FUECOCO)
    	dynmultipush("Quaxly", SPECIES_QUAXLY)
	    dynmultistack(0, 0, TRUE, 6, FALSE, VAR_0x800A, DYN_MULTICHOICE_CB_NONE)
        
		if (var(VAR_RESULT) == SPECIES_BULBASAUR) {
		showmonpic(SPECIES_BULBASAUR, 10, 3)
		playmoncry(SPECIES_BULBASAUR, CRY_MODE_NORMAL)
		msgbox("Are you sure you want Bulbasaur?", MSGBOX_YESNO)
		waitmessage
		} if(var(VAR_RESULT) == NO) {
		hidemonpic
		call(ShinyStarterMenu)
		return

		} elif (var(VAR_RESULT) == YES) {
		createmon(0, 6, SPECIES_BULBASAUR, 5, ITEM_NONE, BALL_CHERISH, NATURE_RANDOM, NUM_ABILITY_PERSONALITY, MON_GENDER_RANDOM, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_DEFAULT, MOVE_DEFAULT, MOVE_DEFAULT, MOVE_DEFAULT, SHINY_MODE_ALWAYS, 0, 0, 10) }
		if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
        playfanfare(MUS_EVOLVED)
        msgbox("{PLAYER} received Bulbasaur!")
		waitfanfare
		waitmessage
		call(NicknamePartyMon2)
		}

		if (var(VAR_RESULT) == SPECIES_CHARMANDER) {
	    playmoncry(SPECIES_CHARMANDER, CRY_MODE_NORMAL)
		showmonpic(SPECIES_CHARMANDER, 10, 3)
		msgbox("Are you sure you want Charmander?", MSGBOX_YESNO) 
		waitmessage
		} if(var(VAR_RESULT) == NO) {
		hidemonpic
		call(ShinyStarterMenu)
		return
		   
		} elif (var(VAR_RESULT) == YES) {
		createmon(0, 6, SPECIES_CHARMANDER, 5, ITEM_NONE, BALL_CHERISH, NATURE_RANDOM, NUM_ABILITY_PERSONALITY, MON_GENDER_RANDOM, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_DEFAULT, MOVE_DEFAULT, MOVE_DEFAULT, MOVE_DEFAULT, SHINY_MODE_ALWAYS, 0, 0, 10) }
