raw`OldaleTown_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, OldaleTown_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

OldaleTown_PokemonCenter_1F_OnTransition:
	setrespawn HEAL_LOCATION_OLDALE_TOWN
	call Common_EventScript_UpdateBrineyLocation
	end

OldaleTown_PokemonCenter_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_OLDALE_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_Gentleman::
	msgbox OldaleTown_PokemonCenter_1F_Text_TrainersCanUsePC, MSGBOX_NPC
	end

OldaleTown_PokemonCenter_1F_EventScript_Boy::
	msgbox OldaleTown_PokemonCenter_1F_Text_PokemonCentersAreGreat, MSGBOX_NPC
	end

OldaleTown_PokemonCenter_1F_EventScript_Girl::
	lock
	faceplayer
	goto_if_set FLAG_SYS_POKEDEX_GET, OldaleTown_PokemonCenter_1F_EventScript_WirelessClubAvailable
	msgbox OldaleTown_PokemonCenter_1F_Text_WirelessClubNotAvailable, MSGBOX_DEFAULT
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_WirelessClubAvailable::
	msgbox OldaleTown_PokemonCenter_1F_Text_TradedInWirelessClub, MSGBOX_DEFAULT
	release
	end

OldaleTown_PokemonCenter_1F_Text_TrainersCanUsePC:
	.string "That PC in the corner there is\n"
	.string "for any POKéMON TRAINER to use.\p"
	.string "Naturally, that means you're welcome\n"
	.string "to use it, too.$"

OldaleTown_PokemonCenter_1F_Text_PokemonCentersAreGreat:
	.string "POKéMON CENTERS are great!\p"
	.string "You can use their services as much\n"
	.string "as you like, and it's all for free.\l"
	.string "You never have to worry!$"

OldaleTown_PokemonCenter_1F_Text_WirelessClubNotAvailable:
	.string "The POKéMON WIRELESS CLUB on\n"
	.string "the second floor was built recently.\p"
	.string "But they say they're still making\n"
	.string "adjustments.$"

OldaleTown_PokemonCenter_1F_Text_TradedInWirelessClub:
	.string "The POKéMON WIRELESS CLUB on\n"
	.string "the second floor was built recently.\p"
	.string "I traded POKéMON right away.$"

`

script MegaAlakazamIntro {
    setspeaker(SP_NAME_UNKNOWN)
    msgbox("Greetings, trainer.")
    goto(PlayerTalkingToMegaAlakazam)
}

script PlayerTalkingToMegaAlakazam {
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    playse(SE_PIN)
    waitse
    waitmovement
    delay(48)
    setspeaker("{PLAYER}")
    msgbox("Are you talking to me?")
    goto(MegaAlakazamTalkingtoPlayer1)
}


script MegaAlakazamTalkingtoPlayer1 {
    setspeaker(SP_NAME_UNKNOWN)
    msgbox("Yes, I'm a talking Mega Alakazam.")
    msgbox("Welcome to the Pokémon Compendium!\nI will be able to aid you.\nFor a price...")
	msgbox("You can call me Wisdom.")
	setspeaker(SP_NAME_WISDOM)
	msgbox(format("I'm a member of the famous Team Blaziken."))
	setspeaker("{PLAYER}")
	msgbox(format("How are you still talking to me?"))
	setspeaker(SP_NAME_WISDOM)
	msgbox(format("{PLAYER}, I can talk to humans."))
	msgbox(format("Here at the Pokémon Compendium you can unlock features that will help you in your journey."))
	setvar(VAR_MEGA_ALAKAZAM_INTRO, 1)
	setvar(VAR_MEGA_ALAKAZAM_MOVE_TUTOR, 1)
	setvar(VAR_MEGA_ALAKAZAM_ITEM_SHOP, 1)
	setvar(VAR_MEGA_ALAKAZAM_CRAFT_ITEMS, 1)
	setvar(VAR_MEGA_ALAKAZAM_WONDER_TRADE, 1)
	setvar(VAR_MEGA_ALAKAZAM_POKEMON_INFUSION, 1)
	setflag(FLAG_MEGA_ALAKAZAM_INTRO)
	if(flag(FLAG_MEGA_ALAKAZAM_INTRO) == TRUE) {
	goto(PokemonCompendium)
    release
    end
}

}
script PokemonCompendium {
	 
	setspeaker(SP_NAME_WISDOM)
	msgbox(format("Welcome to the Pokémon Compendium. What services would you like to use?"))

// Regular static use
dynmultichoice(
  17,
  0,
  FALSE,
  10,
  0,
  DYN_MULTICHOICE_CB_NONE,
  "Move Tutor",
  "Item Shop",
  "Wonder Trade",
  "Perform Ritual",
  "Change Tera Type",
  "Leave"
)

// Result check
switch (var(VAR_RESULT)) {
  case 0:
    goto(MoveTutorMenu)
  case 1:
    goto(ItemShopMenu)
  case 2:
    goto(Wonder_Trade)
  case 3:
	goto(WisdomExitScript)
  case 4:
	goto(TeraTypeChangerMenu)
  case 5:
	goto(WisdomExitScript)
	}
 goto_if_eq(VAR_RESULT, 127, WisdomExitScript)
}
script MoveTutorMenu {
	if(var(VAR_MEGA_ALAKAZAM_MOVE_TUTOR) == 1) {
		setspeaker(SP_NAME_WISDOM)
		msgbox(format("Since this is your first time using my\nmove tutor system let me explain.\p"
		"I can teach your Pokémon moves.\nYou can unlock moves by obtaining gym badges.\p"
		"The more gym badges you obtain increases the list of moves you can access."))
		setvar(VAR_MEGA_ALAKAZAM_MOVE_TUTOR, 2)
		goto(MoveTutorMenuBadgeList)
	} else {
		goto(MoveTutorMenuBadgeList)
	}
	
}

script IntroCheck {

if(flag(FLAG_MEGA_ALAKAZAM_INTRO) == FALSE) {
	goto(MegaAlakazamIntro)
} else { 
	if(flag(FLAG_MEGA_ALAKAZAM_INTRO) == TRUE) {
		goto(PokemonCompendium)
	}
	
}

}

script OtherServices {
	msgbox("Would you like to use another service?", MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
		clearflag(FLAG_MOVETUTOR_SET)
		goto(PokemonCompendium2)
	} else {
		goto(WisdomExitScript)
		clearflag(FLAG_MOVETUTOR_SET)
	}
}

script MoveTutorQuestion {
	msgbox("Do you want to teach a Pokémon\nthe move {STR_VAR_1}?", MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES){
	special(ChooseMonForMoveTutor) 
	goto_if_eq(VAR_RESULT, 0, MoveTutorMenuBadgeList)
  goto_if_eq(VAR_RESULT, 127, MoveTutorMenuBadgeList)
	return
	goto_if_set(FLAG_MOVETUTOR_SET, MoveTutorMenuBadgeList)
	} elif(var(VAR_RESULT) == NO) {
		goto(MoveTutorMenuBadgeList)
		clearflag(FLAG_MOVETUTOR_SET)
	}
}
script WisdomExitScript {
	setspeaker(SP_NAME_WISDOM)
	msgbox(format("If you wish to use my services again return to any Poke Center."))
	clearflag(FLAG_MOVETUTOR_SET)
	release
	end
}

