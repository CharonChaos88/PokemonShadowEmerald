script EvolutionStoneShopMenu {
    lock 
    faceplayer
    
    // --- DYNAMIC MULTICHOICE MENU FOR ALL EVOLUTION STONES ---
    dynmultipush("Fire Stone", ITEM_FIRE_STONE)
    dynmultipush("Water Stone", ITEM_WATER_STONE)
    dynmultipush("Thunder Stone", ITEM_THUNDER_STONE)
    dynmultipush("Leaf Stone", ITEM_LEAF_STONE)
    dynmultipush("Ice Stone", ITEM_ICE_STONE)
    dynmultipush("Moon Stone", ITEM_MOON_STONE)
    dynmultipush("Sun Stone", ITEM_SUN_STONE)
    dynmultipush("Shiny Stone", ITEM_SHINY_STONE)
    dynmultipush("Dusk Stone", ITEM_DUSK_STONE)
    dynmultipush("Dawn Stone", ITEM_DAWN_STONE)

    // --- DYNAMIC MULTICHOICE STACK ---
    dynmultistack(11, 0, FALSE, 6, FALSE, VAR_0x800A, DYN_MULTICHOICE_CB_SHOW_ITEM)

    // Handle exiting the menu safely if they press B
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        goto(PokemonCompendium2)
    }

    // --- SET VAR/BUFFER NAME FOR ALL STONES ---
    if(var(VAR_RESULT) == ITEM_FIRE_STONE)       { setvar(VAR_0x8005, ITEM_FIRE_STONE)       bufferitemname(STR_VAR_1, ITEM_FIRE_STONE) }
    elif(var(VAR_RESULT) == ITEM_WATER_STONE)    { setvar(VAR_0x8005, ITEM_WATER_STONE)      bufferitemname(STR_VAR_1, ITEM_WATER_STONE) }
    elif(var(VAR_RESULT) == ITEM_THUNDER_STONE)  { setvar(VAR_0x8005, ITEM_THUNDER_STONE)    bufferitemname(STR_VAR_1, ITEM_THUNDER_STONE) }
    elif(var(VAR_RESULT) == ITEM_LEAF_STONE)     { setvar(VAR_0x8005, ITEM_LEAF_STONE)       bufferitemname(STR_VAR_1, ITEM_LEAF_STONE) }
    elif(var(VAR_RESULT) == ITEM_ICE_STONE)      { setvar(VAR_0x8005, ITEM_ICE_STONE)        bufferitemname(STR_VAR_1, ITEM_ICE_STONE) }
    elif(var(VAR_RESULT) == ITEM_MOON_STONE)     { setvar(VAR_0x8005, ITEM_MOON_STONE)       bufferitemname(STR_VAR_1, ITEM_MOON_STONE) }
    elif(var(VAR_RESULT) == ITEM_SUN_STONE)      { setvar(VAR_0x8005, ITEM_SUN_STONE)        bufferitemname(STR_VAR_1, ITEM_SUN_STONE) }
    elif(var(VAR_RESULT) == ITEM_SHINY_STONE)    { setvar(VAR_0x8005, ITEM_SHINY_STONE)      bufferitemname(STR_VAR_1, ITEM_SHINY_STONE) }
    elif(var(VAR_RESULT) == ITEM_DUSK_STONE)     { setvar(VAR_0x8005, ITEM_DUSK_STONE)       bufferitemname(STR_VAR_1, ITEM_DUSK_STONE) }
    elif(var(VAR_RESULT) == ITEM_DAWN_STONE)     { setvar(VAR_0x8005, ITEM_DAWN_STONE)       bufferitemname(STR_VAR_1, ITEM_DAWN_STONE) }

    // --- STONE LOGIC CHECKS ---
    
    // 1. FIRE STONE
    if(var(VAR_0x8005) == ITEM_FIRE_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Fire Stone? It will cost a Red Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_RED_SHARD, 1) == FALSE) {
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Red Shard."))  
                goto(EvolutionStoneShopMenu)
            }
            msgbox(format("Thank you! Take this Fire Stone."))
            giveitem(ITEM_FIRE_STONE)
            removeitem(ITEM_RED_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    } 
    // 2. WATER STONE
    elif (var(VAR_0x8005) == ITEM_WATER_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Water Stone? It will cost a Blue Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_BLUE_SHARD, 1) == FALSE) {
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Blue Shard."))  
                goto(EvolutionStoneShopMenu)
            }
            msgbox(format("Thank you! Take this Water Stone."))
            giveitem(ITEM_WATER_STONE)
            removeitem(ITEM_BLUE_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    } 
    // 3. THUNDER STONE
    elif (var(VAR_0x8005) == ITEM_THUNDER_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Thunder Stone?\nIt will cost a Yellow Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_YELLOW_SHARD, 1) == FALSE) {  
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Yellow Shard."))    
                goto(EvolutionStoneShopMenu)    
            }
            msgbox(format("Thank you! Take this Thunder Stone."))
            giveitem(ITEM_THUNDER_STONE)
            removeitem(ITEM_YELLOW_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    } 
    // 4. LEAF STONE
    elif (var(VAR_0x8005) == ITEM_LEAF_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Leaf Stone?\nIt will cost a Green Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_GREEN_SHARD, 1) == FALSE) {  
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Green Shard.")) 
                goto(EvolutionStoneShopMenu)    
            }
            msgbox(format("Thank you! Take this Leaf Stone."))
            giveitem(ITEM_LEAF_STONE)
            removeitem(ITEM_GREEN_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    }
    // 5. ICE STONE (Costs Blue Shard)
    elif (var(VAR_0x8005) == ITEM_ICE_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want an Ice Stone?\nIt will cost a Blue Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_BLUE_SHARD, 1) == FALSE) {  
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Blue Shard.")) 
                goto(EvolutionStoneShopMenu)    
            }
            msgbox(format("Thank you! Take this Ice Stone."))
            giveitem(ITEM_ICE_STONE)
            removeitem(ITEM_BLUE_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    }
    // 6. MOON STONE (Costs Blue Shard)
    elif (var(VAR_0x8005) == ITEM_MOON_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Moon Stone?\nIt will cost a Blue Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_BLUE_SHARD, 1) == FALSE) {  
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Blue Shard.")) 
                goto(EvolutionStoneShopMenu)    
            }
            msgbox(format("Thank you! Take this Moon Stone."))
            giveitem(ITEM_MOON_STONE)
            removeitem(ITEM_BLUE_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    }
    // 7. SUN STONE (Costs Red Shard)
    elif (var(VAR_0x8005) == ITEM_SUN_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Sun Stone?\nIt will cost a Red Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_RED_SHARD, 1) == FALSE) {  
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Red Shard.")) 
                goto(EvolutionStoneShopMenu)    
            }
            msgbox(format("Thank you! Take this Sun Stone."))
            giveitem(ITEM_SUN_STONE)
            removeitem(ITEM_RED_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    }
    // 8. SHINY STONE (Costs Yellow Shard)
    elif (var(VAR_0x8005) == ITEM_SHINY_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Shiny Stone?\nIt will cost a Yellow Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_YELLOW_SHARD, 1) == FALSE) {  
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Yellow Shard.")) 
                goto(EvolutionStoneShopMenu)    
            }
            msgbox(format("Thank you! Take this Shiny Stone."))
            giveitem(ITEM_SHINY_STONE)
            removeitem(ITEM_YELLOW_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    }
    // 9. DUSK STONE (Costs Green Shard)
    elif (var(VAR_0x8005) == ITEM_DUSK_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Dusk Stone?\nIt will cost a Green Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_GREEN_SHARD, 1) == FALSE) {  
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Green Shard.")) 
                goto(EvolutionStoneShopMenu)    
            }
            msgbox(format("Thank you! Take this Dusk Stone."))
            giveitem(ITEM_DUSK_STONE)
            removeitem(ITEM_GREEN_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    }
    // 10. DAWN STONE (Costs Yellow Shard)
    elif (var(VAR_0x8005) == ITEM_DAWN_STONE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Are you sure you want a Dawn Stone?\nIt will cost a Yellow Shard."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(checkitem(ITEM_YELLOW_SHARD, 1) == FALSE) {  
                setspeaker(SP_NAME_WISDOM)
                msgbox(format("You don't have a Yellow Shard.")) 
                goto(EvolutionStoneShopMenu)    
            }
            msgbox(format("Thank you! Take this Dawn Stone."))
            giveitem(ITEM_DAWN_STONE)
            removeitem(ITEM_YELLOW_SHARD, 1)
            goto(StoneVerifyMenu)
        } else {
            goto(EvolutionStoneShopMenu)
        }
    }
    release
    end
}

script StoneVerifyMenu {
    setspeaker(SP_NAME_WISDOM)
    msgbox(format("Would you like to get another evolution stone?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        goto(EvolutionStoneShopMenu)
    } else {
        goto(PokemonCompendium2)
    } 
}

script MoveTutorMenuBadgeList {
dynmultichoice(
  17,
  0,
  FALSE,
  4,
  0,
  DYN_MULTICHOICE_CB_NONE,
  "No Badges",
  "Stone Badge",
  "Knuckle Badge",
  "Dynamo Badge",
  "Heat Badge",
  "Balance Badge",
  "Feather Badge",
  "Mind Badge",
  "Rain Badge",
  "Go Back"
)

switch (var(VAR_RESULT)) {
  case 0:
    goto(NoBadgesMoveTutor)
  case 1:
    goto(StoneBadgeMoveTutor)
  case 2:
    goto(KnuckleBadgeMoveTutor)
  case 3:
    goto(DynamoBadgeMoveTutor)
  case 4:
    goto(HeatBadgeMoveTutor)
  case 5:
    goto(BalanceBadgeMoveTutor)
  case 6:
    goto(FeatherBadgeMoveTutor)
  case 7:
    goto(MindBadgeMoveTutor)
  case 8:
    goto(RainBadgeMoveTutor)
  case 9:
    goto(PokemonCompendium3)
	}
  goto_if_eq(VAR_RESULT, 127, PokemonCompendium2)
}


