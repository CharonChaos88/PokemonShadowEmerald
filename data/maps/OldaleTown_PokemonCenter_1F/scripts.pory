script StoneBadgeMoveTutor {
    lock 
    faceplayer
    if(flag(FLAG_BADGE01_GET) == FALSE) {
        setspeaker(SP_NAME_WISDOM)
        msgbox(format("Unfortunately, it seems you don't have the Knuckle Badge."))
        goto(MoveTutorMenu)
    } else {
        // --- DYNAMIC MULTICHOICE MENU FOR MOVES --- 
        // Early-Game Physical Coverage & Utility (BP 40 - 60)
        dynmultipush("Mach Punch", MOVE_MACH_PUNCH)
        dynmultipush("Bullet Punch", MOVE_BULLET_PUNCH)
        dynmultipush("Ice Shard", MOVE_ICE_SHARD)
        dynmultipush("Shadow Sneak", MOVE_SHADOW_SNEAK)
        dynmultipush("Rock Smash", MOVE_ROCK_SMASH)
        dynmultipush("Cut", MOVE_CUT)
        dynmultipush("False Swipe", MOVE_FALSE_SWIPE)
        dynmultipush("Tackle", MOVE_TACKLE)
        dynmultipush("Pound", MOVE_POUND)
        dynmultipush("Scratch", MOVE_SCRATCH)
        dynmultipush("Double Slap", MOVE_DOUBLE_SLAP)
        dynmultipush("Comet Punch", MOVE_COMET_PUNCH)
        dynmultipush("Fury Cutter", MOVE_FURY_CUTTER)
        dynmultipush("Rollout", MOVE_ROLLOUT)
        dynmultipush("Echoed Voice", MOVE_ECHOED_VOICE)
        dynmultipush("Ember", MOVE_EMBER)
        dynmultipush("Water Gun", MOVE_WATER_GUN)
        dynmultipush("Thundershock", MOVE_THUNDERSHOCK)
        dynmultipush("Gust", MOVE_GUST)
        dynmultipush("Confusion", MOVE_CONFUSION)
        dynmultipush("Mega Drain", MOVE_MEGA_DRAIN)
        dynmultipush("Smog", MOVE_SMOG)
		
        // --- DYNAMIC MULTICHOICE STACK ---
        dynmultistack(17, 0, FALSE, 6, FALSE, VAR_0x800A, DYN_MULTICHOICE_CB_NONE)

        // --- SET VAR/BUFFER NAME FOR MOVES ---
        if (var(VAR_RESULT) == MOVE_MACH_PUNCH)     { setvar(VAR_0x8005, MOVE_MACH_PUNCH)   buffermovename(STR_VAR_1, MOVE_MACH_PUNCH) }
        elif (var(VAR_RESULT) == MOVE_BULLET_PUNCH) { setvar(VAR_0x8005, MOVE_BULLET_PUNCH) buffermovename(STR_VAR_1, MOVE_BULLET_PUNCH) }
        elif (var(VAR_RESULT) == MOVE_ICE_SHARD)    { setvar(VAR_0x8005, MOVE_ICE_SHARD)    buffermovename(STR_VAR_1, MOVE_ICE_SHARD) }
        elif (var(VAR_RESULT) == MOVE_SHADOW_SNEAK) { setvar(VAR_0x8005, MOVE_SHADOW_SNEAK) buffermovename(STR_VAR_1, MOVE_SHADOW_SNEAK) }
        elif (var(VAR_RESULT) == MOVE_ROCK_SMASH)   { setvar(VAR_0x8005, MOVE_ROCK_SMASH)   buffermovename(STR_VAR_1, MOVE_ROCK_SMASH) }
        elif (var(VAR_RESULT) == MOVE_CUT)          { setvar(VAR_0x8005, MOVE_CUT)          buffermovename(STR_VAR_1, MOVE_CUT) }
        elif (var(VAR_RESULT) == MOVE_FALSE_SWIPE) { setvar(VAR_0x8005, MOVE_FALSE_SWIPE) buffermovename(STR_VAR_1, MOVE_FALSE_SWIPE) }
        elif (var(VAR_RESULT) == MOVE_TACKLE)       { setvar(VAR_0x8005, MOVE_TACKLE)       buffermovename(STR_VAR_1, MOVE_TACKLE) }
        elif (var(VAR_RESULT) == MOVE_POUND)        { setvar(VAR_0x8005, MOVE_POUND)        buffermovename(STR_VAR_1, MOVE_POUND) }
        elif (var(VAR_RESULT) == MOVE_SCRATCH)      { setvar(VAR_0x8005, MOVE_SCRATCH)      buffermovename(STR_VAR_1, MOVE_SCRATCH) }
        elif (var(VAR_RESULT) == MOVE_DOUBLE_SLAP)  { setvar(VAR_0x8005, MOVE_DOUBLE_SLAP)  buffermovename(STR_VAR_1, MOVE_DOUBLE_SLAP) }
        elif (var(VAR_RESULT) == MOVE_COMET_PUNCH)  { setvar(VAR_0x8005, MOVE_COMET_PUNCH)  buffermovename(STR_VAR_1, MOVE_COMET_PUNCH) }
        elif (var(VAR_RESULT) == MOVE_FURY_CUTTER)  { setvar(VAR_0x8005, MOVE_FURY_CUTTER)  buffermovename(STR_VAR_1, MOVE_FURY_CUTTER) }
        elif (var(VAR_RESULT) == MOVE_ROLLOUT)      { setvar(VAR_0x8005, MOVE_ROLLOUT)      buffermovename(STR_VAR_1, MOVE_ROLLOUT) }
        elif (var(VAR_RESULT) == MOVE_ECHOED_VOICE) { setvar(VAR_0x8005, MOVE_ECHOED_VOICE) buffermovename(STR_VAR_1, MOVE_ECHOED_VOICE) }
        elif (var(VAR_RESULT) == MOVE_EMBER)        { setvar(VAR_0x8005, MOVE_EMBER)        buffermovename(STR_VAR_1, MOVE_EMBER) }
        elif (var(VAR_RESULT) == MOVE_WATER_GUN)    { setvar(VAR_0x8005, MOVE_WATER_GUN)    buffermovename(STR_VAR_1, MOVE_WATER_GUN) }
        elif (var(VAR_RESULT) == MOVE_THUNDERSHOCK) { setvar(VAR_0x8005, MOVE_THUNDERSHOCK) buffermovename(STR_VAR_1, MOVE_THUNDERSHOCK) }
        elif (var(VAR_RESULT) == MOVE_GUST)         { setvar(VAR_0x8005, MOVE_GUST)         buffermovename(STR_VAR_1, MOVE_GUST) }
        elif (var(VAR_RESULT) == MOVE_CONFUSION)    { setvar(VAR_0x8005, MOVE_CONFUSION)    buffermovename(STR_VAR_1, MOVE_CONFUSION) }
        elif (var(VAR_RESULT) == MOVE_MEGA_DRAIN)   { setvar(VAR_0x8005, MOVE_MEGA_DRAIN)   buffermovename(STR_VAR_1, MOVE_MEGA_DRAIN) }
        elif (var(VAR_RESULT) == MOVE_SMOG)         { setvar(VAR_0x8005, MOVE_SMOG)         buffermovename(STR_VAR_1, MOVE_SMOG) }
        elif (var(VAR_RESULT) == MOVE_FAIRY_WIND)   { setvar(VAR_0x8005, MOVE_FAIRY_WIND)   buffermovename(STR_VAR_1, MOVE_FAIRY_WIND) }

        goto_if_eq(VAR_RESULT, 127, MoveTutorMenuBadgeList)
        goto(MoveTutorQuestion)
    } 
}

script KnuckleBadgeMoveTutor {
	lock 
    faceplayer
	if(flag(FLAG_BADGE02_GET) == FALSE) {
		setspeaker(SP_NAME_WISDOM)
		msgbox(format("Unfortunately, it seems you don't have the Knuckle Badge."))
		goto(MoveTutorMenu)
	} else {
    // --- DYNAMIC MULTICHOICE MENU FOR MOVES ---
    dynmultipush("Fake Out", MOVE_FAKE_OUT)
    dynmultipush("Echoed Voice", MOVE_ECHOED_VOICE)
    dynmultipush("Flame Charge", MOVE_FLAME_CHARGE)
    dynmultipush("Incinerate", MOVE_INCINERATE)
    dynmultipush("Aqua Jet", MOVE_AQUA_JET)
    dynmultipush("Chilling Water", MOVE_CHILLING_WATER)
    dynmultipush("Spark", MOVE_SPARK)
    dynmultipush("Charge Beam", MOVE_CHARGE_BEAM)
    dynmultipush("Razor Leaf", MOVE_RAZOR_LEAF)
    dynmultipush("Magical Leaf", MOVE_MAGICAL_LEAF)
    dynmultipush("Avalanche", MOVE_AVALANCHE)
    dynmultipush("Icy Wind", MOVE_ICY_WIND)
    dynmultipush("Karate Chop", MOVE_KARATE_CHOP)
    dynmultipush("Vacuum Wave", MOVE_VACUUM_WAVE)
    dynmultipush("Poison Fang", MOVE_POISON_FANG)
    dynmultipush("Smog", MOVE_SMOG)
    dynmultipush("Sand Tomb", MOVE_SAND_TOMB)
    dynmultipush("Mud-Slap", MOVE_MUD_SLAP)
    dynmultipush("Dual Wingbeat", MOVE_DUAL_WINGBEAT)
    dynmultipush("Air Cutter", MOVE_AIR_CUTTER)
    dynmultipush("Psycho Cut", MOVE_PSYCHO_CUT)
    dynmultipush("Confusion", MOVE_CONFUSION)
    dynmultipush("Pounce", MOVE_POUNCE)
    dynmultipush("Struggle Bug", MOVE_STRUGGLE_BUG)
    dynmultipush("Smack Down", MOVE_SMACK_DOWN)
    dynmultipush("Ancient Power", MOVE_ANCIENT_POWER)
    dynmultipush("Lick", MOVE_LICK)
    dynmultipush("Night Shade", MOVE_NIGHT_SHADE)
    dynmultipush("Dual Chop", MOVE_DUAL_CHOP)
    dynmultipush("Twister", MOVE_TWISTER)
    dynmultipush("Payback", MOVE_PAYBACK)
    dynmultipush("Snarl", MOVE_SNARL)
    dynmultipush("Bullet Punch", MOVE_BULLET_PUNCH)
    dynmultipush("Mirror Shot", MOVE_MIRROR_SHOT)
    dynmultipush("Disarming Voice", MOVE_DISARMING_VOICE)
    dynmultipush("Fairy Wind", MOVE_FAIRY_WIND)
    // Add more if your engine supports additional moves

    // --- DYNAMIC MULTICHOICE STACK ---
    dynmultistack(17, 0, FALSE, 6, FALSE, VAR_0x800A, DYN_MULTICHOICE_CB_NONE)

    // --- SET VAR/BUFFER NAME FOR MOVES ---
    // (the following if-elif block checks which berry was chosen and sets variables accordingly)
    if(var(VAR_RESULT) == MOVE_FAKE_OUT)     	  { setvar(VAR_0x8005, MOVE_FAKE_OUT)         buffermovename(STR_VAR_1, MOVE_FAKE_OUT) }
    elif(var(VAR_RESULT) == MOVE_ECHOED_VOICE)    { setvar(VAR_0x8005, MOVE_ECHOED_VOICE)     buffermovename(STR_VAR_1, MOVE_ECHOED_VOICE) }
    elif(var(VAR_RESULT) == MOVE_FLAME_CHARGE)    { setvar(VAR_0x8005, MOVE_FLAME_CHARGE)     buffermovename(STR_VAR_1, MOVE_FLAME_CHARGE) }
    elif(var(VAR_RESULT) == MOVE_INCINERATE)      { setvar(VAR_0x8005, MOVE_INCINERATE)       buffermovename(STR_VAR_1, MOVE_INCINERATE) }
    elif(var(VAR_RESULT) == MOVE_AQUA_JET)        { setvar(VAR_0x8005, MOVE_AQUA_JET)         buffermovename(STR_VAR_1, MOVE_AQUA_JET) }
    elif(var(VAR_RESULT) == MOVE_CHILLING_WATER)  { setvar(VAR_0x8005, MOVE_CHILLING_WATER)   buffermovename(STR_VAR_1, MOVE_CHILLING_WATER) }
    elif(var(VAR_RESULT) == MOVE_SPARK)     	  { setvar(VAR_0x8005, MOVE_SPARK)            buffermovename(STR_VAR_1, MOVE_SPARK) }
    elif(var(VAR_RESULT) == MOVE_CHARGE_BEAM)     { setvar(VAR_0x8005, MOVE_CHARGE_BEAM)  	  buffermovename(STR_VAR_1, MOVE_CHARGE_BEAM) }
    elif(var(VAR_RESULT) == MOVE_RAZOR_LEAF)      { setvar(VAR_0x8005, MOVE_RAZOR_LEAF)       buffermovename(STR_VAR_1, MOVE_RAZOR_LEAF) }
