script Wonder_Trade {
	if(flag(FLAG_BADGE01_GET) == TRUE) {
    getpartysize()
    goto_if_eq(VAR_RESULT, 0, EventScript_End)
    chooseboxmon(SELECT_PC_MON_WONDER_TRADE)
    waitstate
    
    // @ 255 (0xFF) is PARTY_NOTHING_CHOSEN. This triggers when the user cancels.
    goto_if_eq(VAR_0x8004, 255, EventScript_End) 
    
    lockall
    delay(20)
    msgbox(format("Searching for a Wonder Trade partner... Press the {A_BUTTON} to continue."))
    waitmessage
    // @ If we get here, they chose a valid mon: (0-5 for Party) OR 254 for (PC Box).
    copyvar(VAR_0x8005, VAR_0x8004)
    special(CreateWonderTradePokemon)
    playse(SE_PC_LOGIN)
    waitse
    playse(SE_DING_DONG)
    msgbox(format("Success! A trade partner was found.\nTrading with {STR_VAR_1}! Press {A_BUTTON} to trade."))
    waitmessage
    waitbuttonpress
    closemessage

    special(DoInGameTradeScene)
	goto(WonderTradeAgain)
	} else {
		setspeaker(SP_NAME_WISDOM)
		msgbox(format("Unfortunately, it seems you don't have the Stone Badge."))
	goto(OtherServices)
	}
}

script WonderTradeAgain {
  lock
  msgbox(format("Want to Wonder Trade again?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
      goto(Wonder_Trade)
    }else {
      goto(PokemonCompendium2)
    }
}


